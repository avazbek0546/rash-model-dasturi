# ---------------------------------------------------------------------------
# Ushbu faylni ".env" nomi bilan nusxalab, qiymatlarni o'zingiznikiga
# almashtiring:  copy .env.example .env
#
# RAILWAY (bulut) uchun: bu fayl serverga tushmaydi. Variables bo'limida
# faqat BOT_TOKEN, ADMIN_ID, WEBAPP_DEV_MODE=0 kiritish kifoya — PORT,
# WEBAPP_HOST, WEBAPP_URL va DB_PATH Railway tomonidan avtomatik beriladi
# (batafsil: docs/12-RAILWAY-JOYLASHTIRISH.md).
# ---------------------------------------------------------------------------

# @BotFather dan olingan bot tokeni (majburiy)
BOT_TOKEN=123456789:AAExampleTokenReplaceMeWithYourOwn

# O'qituvchi (admin) Telegram ID si. /stats, /new_exam, /exams shu ID uchun ishlaydi.
# Bo'sh qoldirilsa admin komandalar o'chiriladi.
ADMIN_ID=

# Qo'shimcha administratorlar (vergul bilan): ADMIN_IDS=111111,222222
# Bu yerdagi ID'lar "egasi" hisoblanadi va bot ichidan O'CHIRILMAYDI.
# Botdan turib admin qo'shish/o'chirish: /admins paneli (bazadagi `bot_admins`).
ADMIN_IDS=

# Ma'lumotlar bazasi fayli (bo'sh qoldirilsa: data/math_bot.db)
DB_PATH=data/math_bot.db

# Bitta testdagi savollar soni (FAQAT eski/mashq rejimi uchun; yangi imtihon
# platformasida savollar sonini o'qituvchi /new_exam orqali belgilaydi)
QUESTIONS_PER_TEST=10

# ---------------------------------------------------------------------------
# Telegram Web App (Mini App)
# ---------------------------------------------------------------------------
# Web App ochiladigan HTTPS manzil (Telegram faqat https ni qabul qiladi).
# Bo'sh qoldirilsa bot Web App tugmasini ko'rsatmaydi.
# Dev uchun: Cloudflare Tunnel yoki ngrok bergan manzilni yozing.
#   cloudflared tunnel --url http://localhost:8080
WEBAPP_URL=https://xxxx-xxxx-xxxx.trycloudflare.com

# Mini App kesh-buster versiyasi. Dizayn/JS o'zgarganda oshiring.
WEBAPP_VERSION=23

# Web App HTTP server qaysi manzil va portda tinglaydi.
# Bulutda (Railway) bu ikkalasini QO'LDA yozish shart emas: config.py
# `PORT` o'zgaruvchisini va bulut muhitini o'zi aniqlab, 0.0.0.0:<PORT> ga
# o'tadi. Lokal ishlab chiqish uchun quyidagi qiymatlar qulay.
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080

# FAQAT lokal test uchun: initData tekshiruvisiz X-Debug-User-Id qabul qilinadi.
# Ishlab chiqarishda albatta 0 bo'lishi shart!
WEBAPP_DEV_MODE=0

# initData "yangi" hisoblanadigan oraliq (sekund): 86400 = 24 soat
INITDATA_MAX_AGE=86400

# ---------------------------------------------------------------------------
# Vaqt zonasi va fon vazifalari
# ---------------------------------------------------------------------------
# O'qituvchi vaqtni shu zonada kiritadi/ko'radi (bazada doim UTC saqlanadi)
TIMEZONE=Asia/Tashkent

# Natijalarni baholovchi fon vazifasi necha sekundda bir tekshiradi
GRADING_INTERVAL=30

# Natija bildirishnomasi (`result_time` kelgach) necha sekundda bir tekshiradi
RESULT_NOTIFY_INTERVAL=60

# Item-level baholash (MVP): javoblarni `responses` jadvalidan o'qish.
# 0 (standart) — eski `user_answers` oqimi; 1 — item-level oqim
# (sessiya/urinish/javoblar topilmasa avtomatik eski oqimga qaytadi).
ITEM_LEVEL_GRADING_ENABLED=0

# Qiyinchilikni tekislash (shrinkaj / empirik Bayes):
#   b = w·b_auto + (1−w)·b_teacher,  w = N/(N+K)
# 0 (standart) — `b` faqat o'qituvchi bahosidan olinadi;
# 1 — o'qituvchi bahosi va javob ma'lumoti N ga qarab aralashtiriladi.
DIFFICULTY_SHRINKAGE_ENABLED=0
# Shrinkaj konstantasi `K` (N = K bo'lganda o'qituvchi va ma'lumot vazni teng).
DIFFICULTY_SHRINK_K=30

# Test kodi minimal uzunligi
MIN_TEST_CODE_LENGTH=4

# Rasch modeli: theta (θ) qidiruv chegarasi -> -THETA_BOUND ... +THETA_BOUND
THETA_BOUND=3.0

# Yakuniy ball (0..100) shu chegaraga QISILADI — 0/100 ko'rinmasligi uchun.
# Oddiy ballar tegilmaydi; faqat eng chet (mukammal / butunlay xato) qisiladi.
SCALED_CAP_MIN=9
SCALED_CAP_MAX=91

# Logging darajasi: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO